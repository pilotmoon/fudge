{
  "name": "@pilotmoon/fudge",
  "version": "1.0.0",
  "module": "index.ts",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run build && node --test",
    "build": "npm run check && esbuild index.ts --bundle --outfile=index.js --platform=node --format=esm --external:case-anything --external:js-yaml --external:fast-plist --external:valibot --external:emoji-regex",
    "watch": "esbuild index.ts --bundle --outfile=index.js --platform=node --format=esm --external:case-anything --external:js-yaml --external:fast-plist --external:valibot --external:emoji-regex --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/js-yaml": "4.0.9",
    "axios": "1.6.8",
    "esbuild": "0.28.2",
    "fast-stable-stringify": "1.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "case-anything": "2.1.13",
    "emoji-regex": "10.5.0",
    "fast-plist": "0.1.3",
    "js-yaml": "4.1.0",
    "valibot": "1.1.0"
  }
}
